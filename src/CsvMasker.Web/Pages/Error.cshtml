@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Something went wrong</h1>
<p>The request could not be completed. Your files are deleted automatically if a job is abandoned.</p>
<p><a asp-page="/Index">Back to the start</a></p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
}
