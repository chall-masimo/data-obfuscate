@page "/Jobs/{id:guid}/Preview"
@model CsvMasker.Web.Pages.Jobs.PreviewModel
@{
    ViewData["Title"] = "Preview";
    var header = Model.Job.Profile.Header;
}

<partial name="_JobNav" model="Model.Job" />

<h1 class="h3">Preview</h1>
<p class="text-muted">
    The first @Model.Preview.Count rows: each original row with its masked version underneath. The full run uses the same mapping.
</p>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" data-test="preview-error">@Model.Error</div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered preview-table small">
            <thead class="table-light">
                <tr>
                    <th></th>
                    @foreach (var name in header.OriginalNames)
                    {
                        <th>@name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Preview)
                {
                    <tr class="original">
                        <th class="text-muted fw-normal">Original</th>
                        @foreach (var value in row.Original)
                        {
                            <td>@Display.Truncate(value, 40)</td>
                        }
                    </tr>
                    <tr class="masked">
                        <th class="fw-normal">Masked</th>
                        @foreach (var value in row.Masked)
                        {
                            <td>@Display.Truncate(value, 40)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-page="/Jobs/Review" asp-route-id="@Model.Job.Id">Back to review</a>
    @if (Model.Error is null)
    {
        <form method="post" asp-page-handler="Run" asp-route-id="@Model.Job.Id">
            <button type="submit" class="btn btn-primary">Run masking on the whole file</button>
        </form>
    }
</div>
