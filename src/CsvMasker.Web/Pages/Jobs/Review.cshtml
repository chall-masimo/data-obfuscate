@page "/Jobs/{id:guid}/Review"
@model CsvMasker.Web.Pages.Jobs.ReviewModel
@{
    ViewData["Title"] = "Review columns";
    var file = Model.Job.Profile;
    var strategies = Html.GetEnumSelectList<MaskingStrategy>();
    var fakeKinds = Html.GetEnumSelectList<FakeKind>();
    var perturbModes = new[]
    {
        new SelectListItem("Per row", nameof(PerturbMode.PerRow)),
        new SelectListItem("Global (one factor)", nameof(PerturbMode.Global)),
        new SelectListItem("Per entity (linked)", nameof(PerturbMode.PerEntity)),
    };
    var dateShiftModes = new[]
    {
        new SelectListItem("Global (one offset)", nameof(DateShiftMode.Global)),
        new SelectListItem("Per entity (linked)", nameof(DateShiftMode.PerEntity)),
    };
}

<partial name="_JobNav" model="Model.Job" />

<h1 class="h3">Review columns</h1>
<p class="text-muted">
    @Display.Delimiter(file.Dialect.Delimiter)-delimited, @file.Dialect.Encoding.Name,
    @file.Columns.Count columns.
    @if (file.ReachedEndOfFile)
    {
        <span>@file.RowsProfiled.ToString("N0") rows profiled (the whole file).</span>
    }
    else
    {
        <span>Profiled the first @file.RowsProfiled.ToString("N0") rows; counts marked ≈ are estimates for the full file.</span>
    }
    @if (file.MalformedRowCount > 0)
    {
        <span class="text-danger">@file.MalformedRowCount.ToString("N0") malformed row(s) found in the sample (first at record @file.MalformedRecordNumbers[0]).</span>
    }
</p>

@if (Model.Notice is not null)
{
    <div class="alert alert-warning">@Model.Notice</div>
}

@{ var applied = Model.Job.Recipe; }
@if (applied is null)
{
    <div class="alert alert-light border" data-test="recipe-none">Pre-filled from the profiler's suggestions.</div>
}
else if (applied.Kind == CsvMasker.Web.Recipes.RecipeMatchKind.Exact)
{
    <div class="alert alert-info" data-test="recipe-exact">
        Pre-filled from recipe <strong>@applied.Name</strong> (saved by @applied.Owner); exact match for this file's columns.
    </div>
}
else
{
    <div class="alert alert-warning" data-test="recipe-partial">
        Pre-filled from recipe <strong>@applied.Name</strong> (saved by @applied.Owner); partial match:
        @applied.Matched of @applied.Total columns.
        @if (applied.Unassigned > 0)
        {
            <strong>@applied.Unassigned column(s) are new and need a strategy</strong><span> (highlighted below).</span>
        }
        @if (applied.DroppedLinks > 0)
        {
            <div data-test="dropped-links">@applied.DroppedLinks link(s) from the recipe refer to columns this file doesn't have and were left out.</div>
        }
    </div>
}

@{ var groups = Model.Groups(); }
@if (groups.Count > 0)
{
    <div class="alert alert-light border small" data-test="entity-groups">
        <strong>Entity groups.</strong> Linked columns are seeded from their anchor, so each entity gets one coherent fake identity:
        @foreach (var group in groups)
        {
            <div>@Model.NameOf(group.Anchor) → @string.Join(", ", group.Members.Select(Model.NameOf))</div>
        }
    </div>
}

@if (Model.RecipeChoices.Count > 0)
{
    <form method="post" asp-page-handler="ApplyRecipe" asp-route-id="@Model.Job.Id" class="d-flex flex-wrap gap-2 align-items-center mb-3" data-test="recipe-selector">
        <label for="recipeId" class="small text-muted">Pre-fill from</label>
        <select id="recipeId" name="recipeId" class="form-select form-select-sm w-auto">
            <option value="">Profiler suggestions</option>
            @foreach (var choice in Model.RecipeChoices)
            {
                <option value="@choice.Recipe.Id" selected="@(applied?.Id == choice.Recipe.Id)">
                    @choice.Recipe.Name (@choice.Recipe.Owner) — @(choice.Kind == CsvMasker.Web.Recipes.RecipeMatchKind.Exact ? "exact match" : $"{choice.Matched} of {choice.Total} columns")
                </option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">Apply</button>
        <span class="small text-muted">Applying replaces the choices below.</span>
    </form>
}

<form method="post" data-test="review-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (Model.PlanProblems.Count > 0)
    {
        <ul class="text-danger">
            @foreach (var problem in Model.PlanProblems)
            {
                <li>@problem</li>
            }
        </ul>
    }

    <div class="table-responsive">
        <table class="table table-sm align-top review-table">
            <thead>
                <tr>
                    <th>Column</th>
                    <th>Detected</th>
                    <th>Stats</th>
                    <th>Sample values</th>
                    <th style="min-width: 18rem">
                        Strategy
                        <a asp-page="/Index" asp-fragment="strategies" target="_blank" class="small fw-normal ms-1" data-test="strategy-help">What do these mean?</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Columns.Count; i++)
                {
                    var column = Model.ProfileFor(Model.Columns[i]);
                    bool unassigned = Model.Columns[i].Strategy is null;
                    <tr data-column-row class="@(unassigned ? "table-warning" : "")" data-unassigned="@(unassigned ? "true" : "false")">
                        <td>
                            <input type="hidden" asp-for="Columns[i].Key" />
                            <strong>@(string.IsNullOrWhiteSpace(column.OriginalName) ? "(blank)" : column.OriginalName)</strong>
                            @if (column.Key != column.OriginalName)
                            {
                                <div class="small text-muted">key: @column.Key</div>
                            }
                        </td>
                        <td>
                            <span class="badge text-bg-secondary">@column.Type</span>
                            <div class="small text-muted">@column.Reason</div>
                            @foreach (var warning in column.Warnings)
                            {
                                <div class="small text-warning-emphasis">⚠ @warning</div>
                            }
                        </td>
                        <td class="small text-nowrap">
                            distinct @(column.DistinctIsEstimate ? "≈" : "")@column.DistinctCount.ToString("N0")<br />
                            null @Display.Percent(column.NullRate), blank @Display.Percent(column.BlankRate)<br />
                            length @column.MinLength–@column.MaxLength
                        </td>
                        <td class="small samples">
                            @foreach (var sample in column.SampleValues)
                            {
                                <div><code>@Display.Truncate(sample)</code></div>
                            }
                        </td>
                        <td>
                            <select asp-for="Columns[i].Strategy" asp-items="strategies" class="form-select form-select-sm" data-strategy-select>
                                <option value="">— choose —</option>
                            </select>
                            @if (unassigned && Model.Suggestions.TryGetValue(column.Key, out var suggested))
                            {
                                <div class="small text-muted">Not in the recipe. Suggested: @suggested.Strategy</div>
                            }
                            <div class="opt mt-1" data-for="Fake">
                                <select asp-for="Columns[i].FakeKind" asp-items="fakeKinds" class="form-select form-select-sm"></select>
                            </div>
                            <div class="opt mt-1" data-for="HashId">
                                <input asp-for="Columns[i].Prefix" class="form-control form-control-sm" placeholder="Prefix (optional), e.g. T-" />
                            </div>
                            <div class="opt mt-1" data-for="Perturb">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">±</span>
                                    <input asp-for="Columns[i].PerturbPercent" type="number" min="1" max="99" class="form-control" />
                                    <span class="input-group-text">%</span>
                                    <select asp-for="Columns[i].PerturbMode" asp-items="perturbModes" class="form-select"></select>
                                </div>
                                <div class="form-check form-check-inline small">
                                    <input asp-for="Columns[i].IsCount" class="form-check-input" />
                                    <label asp-for="Columns[i].IsCount" class="form-check-label">Count (whole numbers, ≥ 1 stays ≥ 1)</label>
                                </div>
                                <span asp-validation-for="Columns[i].PerturbPercent" class="text-danger small"></span>
                            </div>
                            <div class="opt mt-1" data-for="DateShift">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">± days</span>
                                    <input asp-for="Columns[i].MaxDays" type="number" min="1" max="3650" class="form-control" />
                                    <select asp-for="Columns[i].DateShiftMode" asp-items="dateShiftModes" class="form-select"></select>
                                </div>
                                <div class="form-check form-check-inline small">
                                    <input asp-for="Columns[i].KeepWeekday" class="form-check-input" />
                                    <label asp-for="Columns[i].KeepWeekday" class="form-check-label">Keep weekday</label>
                                </div>
                                <span asp-validation-for="Columns[i].MaxDays" class="text-danger small"></span>
                            </div>
                            <div class="opt mt-1" data-for="Redact">
                                <input asp-for="Columns[i].RedactText" class="form-control form-control-sm" placeholder="[REDACTED]" />
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-2 small" data-test="links">
                                <select asp-for="Columns[i].LinkedTo" asp-items="Model.AnchorChoices(column.Key, Model.Columns[i].LinkedTo)"
                                        class="form-select form-select-sm w-auto" title="Seed this column from an anchor column, so one entity gets one coherent identity">
                                    <option value="">Not linked</option>
                                </select>
                                <select asp-for="Columns[i].SameMappingAs" asp-items="Model.DomainChoices(column.Key, Model.Columns[i].SameMappingAs)"
                                        class="form-select form-select-sm w-auto" title="Map values exactly as another column does (e.g. BillTo and ShipTo)">
                                    <option value="">Own mapping</option>
                                </select>
                            </div>
                            @foreach (var note in Model.NotesFor(i))
                            {
                                <div class="small text-warning-emphasis" data-test="link-note">⚠ @note</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card card-body mb-3" style="max-width: 48rem">
        <div class="form-check">
            <input asp-for="SkipMalformed" class="form-check-input" />
            <label asp-for="SkipMalformed" class="form-check-label">
                Skip malformed rows (wrong number of fields) instead of stopping. Skipped rows are left out of the output and listed by row number.
            </label>
        </div>
        <div class="form-check mt-2">
            <input asp-for="Confirmed" class="form-check-input" />
            <label asp-for="Confirmed" class="form-check-label fw-bold">I have reviewed the strategy for every column.</label>
        </div>
        <span asp-validation-for="Confirmed" class="text-danger small"></span>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Continue to preview</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/review.js" asp-append-version="true"></script>
}
